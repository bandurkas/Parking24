# Postgres (docker compose поднимает db с этим паролем; web получает DATABASE_URL автоматически)
POSTGRES_PASSWORD=change-me
# Локально: DATABASE_URL="postgresql://user@localhost:5432/parking24_dev"
DATABASE_URL="postgresql://parking24:change-me@db:5432/parking24"

# Пароли, которыми seed создаёт пользователей (только при первом запуске; потом менять в /admin/settings/users)
SEED_OWNER_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_GUARD_PASSWORD=
SEED_DRIVER_PASSWORD=
SEED_PARKER_PASSWORD=

# Секрет для POST /api/cron/automations (заголовок X-Cron-Secret), не короче 16 символов,
# иначе вход выключен: openssl rand -hex 32
CRON_SECRET=
# "1" — минутный тик в процессе сервера (src/instrumentation.ts). Только на stage и проде;
# локально и в e2e держать 0, тик дёргать через /api/cron/automations
RUN_SCHEDULER=1

NEXT_PUBLIC_SITE_URL=https://parking24.168-231-118-173.sslip.io

# Basic Auth stage (необязательно)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# ── Ф14: Wazzup (WhatsApp, Telegram, MAX). Только серверный .env, в браузер не уходит ничего ──
# Ключ из кабинета: «Интеграция с CRM» → API. Пусто — провайдера нет, сообщения не уходят.
# Отправку включает владелец в /admin/settings («Сообщения»), по умолчанию выключено.
WAZZUP_API_KEY=
# Секрет в адресе вебхука /api/webhooks/wazzup/<секрет>, не короче 32 символов: openssl rand -hex 32
WAZZUP_WEBHOOK_SECRET=
# Публичный https-адрес сайта для вебхука. Пусто — кнопка «Подключить вебхук» ничего не регистрирует
# (адрес один на весь аккаунт Wazzup: нельзя, чтобы его перехватил локальный запуск)
WAZZUP_WEBHOOK_BASE=
# По умолчанию https://api.wazzup24.com/v3; в тестах — адрес заглушки tests/mocks/wazzup-mock.mjs
WAZZUP_API_BASE=
# Только dev и e2e: тестовая ручка /api/dev/wazzup-send (работает лишь с WAZZUP_API_BASE на localhost)
WAZZUP_TEST_HOOKS=0
