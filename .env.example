# Postgres (docker compose поднимает db с этим паролем; web получает DATABASE_URL автоматически)
POSTGRES_PASSWORD=change-me
# Локально: DATABASE_URL="postgresql://user@localhost:5432/parking24_dev"
DATABASE_URL="postgresql://parking24:change-me@db:5432/parking24"

# Пароли, которыми seed создаёт пользователей (только при первом запуске; потом менять в /admin/settings/users)
SEED_OWNER_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_GUARD_PASSWORD=

# Секрет для /api/cron/automations (заголовок X-Cron-Secret)
CRON_SECRET=
# 1 — встроенный планировщик автоматизаций (setInterval в instrumentation.ts)
RUN_SCHEDULER=1

NEXT_PUBLIC_SITE_URL=https://parking24.168-231-118-173.sslip.io

# Basic Auth stage (необязательно)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
